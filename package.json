{
  "name": "omni-mini-mfe",
  "private": false,
  "version": "1.0.0",
  "description": "Micro-Frontend Super App & Mini App Starter Template & CLI Scaffolding Package",
  "type": "module",
  "bin": {
    "omni-mini-mfe": "./bin/omni-mini-mfe.mjs",
    "omni-mini-mfe:create-super-app": "./bin/create-super-app.mjs",
    "omni-mini-mfe:create-mini-app": "./bin/create-mini-app.mjs",
    "create-super-app": "./bin/create-super-app.mjs",
    "create-mini-app": "./bin/create-mini-app.mjs"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "node ./scripts/generate-icons.js && vite build && node ./scripts/prepare-gh-pages.mjs",
    "build:gh-pages": "node ./scripts/generate-icons.js && vite build && node ./scripts/prepare-gh-pages.mjs",
    "deploy:gh-pages": "node ./scripts/deploy-gh-pages.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:rules": "eslint firestore.rules",
    "omni-mini-mfe:create-super-app": "node ./bin/omni-mini-mfe.mjs create-super-app",
    "omni-mini-mfe:create-mini-app": "node ./bin/omni-mini-mfe.mjs create-mini-app",
    "create-super-app": "node ./bin/omni-mini-mfe.mjs create-super-app",
    "create-mini-app": "node ./bin/omni-mini-mfe.mjs create-mini-app",
    "cap:sync": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "icons:generate": "node ./scripts/generate-icons.js",
    "mobile:build": "node ./scripts/generate-icons.js && vite build && npx cap sync android",
    "android:apk": "node ./scripts/generate-icons.js && vite build && (test -d android || npx cap add android) && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:aab": "node ./scripts/generate-icons.js && vite build && (test -d android || npx cap add android) && npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capacitor/toast": "^8.0.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  }
}
